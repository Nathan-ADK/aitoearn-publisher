{
  "name": "@nathan-adk/aitoearn-publisher",
  "version": "0.1.0",
  "description": "Standalone local CLI to publish npm packages and create GitHub Releases. No aitoearn.cn server API required.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
